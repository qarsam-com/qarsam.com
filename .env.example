# Email Configuration for Contact Form
# Destination email where contact form submissions will be sent
CONTACT_FORM_EMAIL=qarsam.com@gmail.com

# SMTP Configuration (required for email delivery)
# Gmail: Use an app-specific password (not your regular password)
# See: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# From email address (should match SMTP_USER or be authenticated)
SMTP_FROM_EMAIL=noreply@qarsam.com
SMTP_FROM_NAME=Qarsam Contact Form

# WhatsApp Configuration
# WhatsApp Business number for contact links (with country code, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=923396520107

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://qarsam.com

# Rate Limiting (optional)
# Maximum contact form submissions per IP per day
RATE_LIMIT_SUBMISSIONS_PER_DAY=5
RATE_LIMIT_SUBMISSIONS_PER_HOUR=2

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=your-ga-id-here
